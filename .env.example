# Retriva Configuration
# Copy this file to .env and customize values before running.

# ─────────────────────────────────────────
# Server
# ─────────────────────────────────────────
RETRIVA_PORT=8080

# ─────────────────────────────────────────
# Storage
# ─────────────────────────────────────────
RETRIVA_DATA_DIR=/data
RETRIVA_DATABASE=/data/retriva.db

# ─────────────────────────────────────────
# Retention
# ─────────────────────────────────────────
# Number of days to keep media on the server before expiration.
RETRIVA_RETENTION_DAYS=7

# ─────────────────────────────────────────
# Limits
# ─────────────────────────────────────────
# Maximum file size for a single download (supports GB/MB/KB suffixes or raw bytes).
RETRIVA_MAX_FILE_SIZE_BYTES=2GB

# Timeout for initial HTTP requests (URL validation, HEAD checks).
RETRIVA_REQUEST_TIMEOUT=30s

# Timeout for the full download of a media file.
RETRIVA_DOWNLOAD_TIMEOUT=30m

# Maximum number of HTTP redirects to follow per request.
RETRIVA_MAX_REDIRECTS=5

# ─────────────────────────────────────────
# Workers
# ─────────────────────────────────────────
# Number of concurrent download workers. 2 is plenty for personal use.
RETRIVA_WORKERS=2

# ─────────────────────────────────────────
# Authentication
# ─────────────────────────────────────────
# Optional bearer token. Leave empty to disable authentication.
# Recommended if you expose Retriva on the internet (e.g., via Tailscale, Cloudflare Tunnel).
RETRIVA_AUTH_TOKEN=

# ─────────────────────────────────────────
# Logging
# ─────────────────────────────────────────
# Log level: debug | info | warn | error
RETRIVA_LOG_LEVEL=info
